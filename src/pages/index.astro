---
import Layout from "../layouts/Layout.astro";

const features = [
  {
    icon: "🎭",
    title: "Real-Time Animation",
    desc: "Animate your character live while streaming or recording.",
  },
  {
    icon: "🎤",
    title: "Mic-Based Lip Sync",
    desc: "Automatic mouth movement driven by your voice input.",
  },
  {
    icon: "🎚️",
    title: "Adjustable Sensitivity",
    desc: "Fine-tune thresholds to match your mic and speaking style.",
  },
  {
    icon: "🪶",
    title: "Lightweight & Simple",
    desc: "Clean interface, minimal setup. Focus on creating, not configuring.",
  },
  {
    icon: "🟩",
    title: "Green Screen Support",
    desc: "Chroma key ready for OBS, Streamlabs, and any recording setup.",
  },
  {
    icon: "⚙️",
    title: "Built with Godot",
    desc: "Powered by the open-source Godot Engine.",
  },
];

const steps = [
  {
    num: "01",
    title: "Download",
    desc: "Grab the latest release. No account needed.",
  },
  {
    num: "02",
    title: "Launch",
    desc: "Open Chibi-FX — minimal and straightforward.",
  },
  {
    num: "03",
    title: "Load avatar",
    desc: "Import your custom character and frames.",
  },
  {
    num: "04",
    title: "Configure audio",
    desc: "Pick your mic and dial in sensitivity.",
  },
  { num: "05", title: "Go live!", desc: "Start streaming or recording." },
];

const roadmap = [
  { icon: "🎨", text: "More avatar customization" },
  { icon: "😊", text: "Additional facial expressions" },
  { icon: "🎭", text: "Expanded animation controls" },
  { icon: "🎯", text: "Improved tracking accuracy" },
  { icon: "⚡", text: "Quality-of-life improvements" },
  { icon: "🛠️", text: "Performance optimizations" },
];
---

<Layout title="Chibi-FX — Your Cute 2D VTuber Companion">
  <!-- Nav -->
  <nav
    id="main-nav"
    class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-all duration-300 backdrop-blur-md bg-bg/80"
    aria-label="Main navigation"
  >
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
      <a
        href="#"
        class="flex items-center gap-2 text-lg font-extrabold"
        aria-label="Home"
      >
        <span class="text-xl" aria-hidden="true">🐱</span>
        <span>Chibi<span class="text-accent">FX</span></span>
      </a>

      <ul class="hidden items-center gap-8 md:flex" role="list">
        <li>
          <a
            href="#features"
            class="text-sm font-medium text-text-muted hover:text-accent transition-colors"
            >Features</a
          >
        </li>
        <li>
          <a
            href="#how-it-works"
            class="text-sm font-medium text-text-muted hover:text-accent transition-colors"
            >How it works</a
          >
        </li>
        <li>
          <a
            href="#roadmap"
            class="text-sm font-medium text-text-muted hover:text-accent transition-colors"
            >Roadmap</a
          >
        </li>
      </ul>

      <a
        href="https://geraldglitch.itch.io/chibifx"
        class="rounded-full bg-accent px-5 py-2 text-sm font-bold text-bg transition-transform hover:scale-105"
      >
        Download
      </a>
    </div>
  </nav>

  <main>
    <!-- Hero -->
    <section
      id="hero"
      class="relative overflow-hidden pt-28 pb-20 md:pt-36 md:pb-28"
      aria-labelledby="hero-heading"
    >
      <!-- Subtle gradient orbs -->
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div
          class="absolute -top-32 -left-32 h-[500px] w-[500px] rounded-full bg-accent/8 blur-[120px]"
        >
        </div>
        <div
          class="absolute -bottom-40 -right-40 h-[400px] w-[400px] rounded-full bg-accent/6 blur-[100px]"
        >
        </div>
      </div>

      <div
        class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2 md:gap-16"
      >
        <!-- Text -->
        <div class="order-2 text-center md:order-1 md:text-left">
          <div
            class="mb-5 inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/10 px-4 py-1.5 text-xs font-bold tracking-wide text-accent"
          >
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-accent"
            ></span>
            Active Development
          </div>

          <h1
            id="hero-heading"
            class="mb-5 text-4xl font-extrabold leading-tight tracking-tight md:text-5xl lg:text-6xl"
          >
            Your Cute &amp;<br />Lightweight<br />
            <span class="text-accent">2D VTuber</span> Companion
          </h1>

          <p
            class="mx-auto mb-8 max-w-md text-base leading-relaxed text-text-muted md:mx-0"
          >
            Bring your animated avatar to life for streaming, content creation,
            and videos — minimal setup required.
          </p>

          <div class="flex flex-wrap justify-center gap-3 md:justify-start">
            <a
              href="https://geraldglitch.itch.io/chibifx"
              id="hero-download-btn"
              class="inline-flex items-center gap-2 rounded-full bg-accent px-7 py-3 font-bold text-bg transition-transform hover:scale-105"
            >
              Download Free
              <svg
                class="h-5 w-5"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                ></path><polyline points="7 10 12 15 17 10"></polyline><line
                  x1="12"
                  y1="15"
                  x2="12"
                  y2="3"></line></svg
              >
            </a>
            <a
              href="#features"
              class="inline-flex items-center rounded-full border border-border px-7 py-3 font-bold text-text-muted transition-colors hover:border-accent hover:text-accent"
            >
              See features
            </a>
          </div>

          <div
            class="mt-6 flex flex-wrap justify-center gap-2 md:justify-start"
          >
            {
              ["Godot Engine", "Desktop", "Free & Open"].map((tag) => (
                <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-semibold text-text-dim">
                  {tag}
                </span>
              ))
            }
          </div>
        </div>

        <!-- Mascot -->
        <div class="order-1 flex justify-center md:order-2">
          <div class="relative">
            <img
              src="/mascot.png"
              alt="Chibi-FX mascot — a fluffy black cat with green eyes"
              class="w-64 drop-shadow-2xl md:w-80 lg:w-96 animate-[float_5s_ease-in-out_infinite]"
              width="480"
              height="480"
              loading="eager"
            />
            <!-- Floating chips -->
            <div
              class="absolute top-4 -left-6 flex items-center gap-2 rounded-full border border-border bg-surface/90 px-3 py-1.5 text-xs font-bold shadow-lg backdrop-blur-sm animate-[float_4s_ease-in-out_infinite_0.5s]"
            >
              <span aria-hidden="true">🎤</span> Lip sync active
            </div>
            <div
              class="absolute -right-4 bottom-12 flex items-center gap-2 rounded-full border border-border bg-surface/90 px-3 py-1.5 text-xs font-bold shadow-lg backdrop-blur-sm animate-[float_5s_ease-in-out_infinite_1s]"
            >
              <span aria-hidden="true">🟩</span> Green screen ready
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section
      id="features"
      class="bg-surface py-20 md:py-28"
      aria-labelledby="features-heading"
    >
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-14 text-center">
          <span
            class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-accent"
            >Why Chibi-FX?</span
          >
          <h2
            id="features-heading"
            class="text-3xl font-extrabold tracking-tight md:text-4xl"
          >
            Everything you need to go live
          </h2>
          <p class="mx-auto mt-3 max-w-lg text-text-muted">
            A focused toolset for content creators who want a cute avatar
            without the complexity.
          </p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
          {
            features.map((f) => (
              <li class="group rounded-2xl border border-border bg-bg p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-[0_8px_30px_rgba(107,191,89,0.08)]">
                <div class="mb-3 text-3xl">{f.icon}</div>
                <h3 class="mb-1.5 font-bold">{f.title}</h3>
                <p class="text-sm leading-relaxed text-text-muted">{f.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- How it works -->
    <section
      id="how-it-works"
      class="py-20 md:py-28"
      aria-labelledby="how-heading"
    >
      <div class="mx-auto max-w-6xl px-6">
        <div class="mb-14 text-center">
          <span
            class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-accent"
            >Getting started</span
          >
          <h2
            id="how-heading"
            class="text-3xl font-extrabold tracking-tight md:text-4xl"
          >
            Up and streaming in minutes
          </h2>
        </div>

        <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-5" role="list">
          {
            steps.map((s) => (
              <li class="flex flex-col gap-2">
                <span class="text-3xl font-black text-accent/60">{s.num}</span>
                <h3 class="font-bold">{s.title}</h3>
                <p class="text-sm leading-relaxed text-text-muted">{s.desc}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Roadmap -->
    <section
      id="roadmap"
      class="bg-surface py-20 md:py-28"
      aria-labelledby="roadmap-heading"
    >
      <div class="mx-auto max-w-4xl px-6">
        <div class="mb-14 text-center">
          <span
            class="mb-2 block text-xs font-extrabold uppercase tracking-widest text-accent"
            >What's next</span
          >
          <h2
            id="roadmap-heading"
            class="text-3xl font-extrabold tracking-tight md:text-4xl"
          >
            The road ahead
          </h2>
          <p class="mx-auto mt-3 max-w-lg text-text-muted">
            Chibi-FX is actively evolving. Here's a glimpse of what's coming.
          </p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2" role="list">
          {
            roadmap.map((r) => (
              <li class="flex items-center gap-3 rounded-xl border border-border bg-surface-2 px-5 py-4 text-sm font-semibold transition-colors hover:border-accent/40 hover:bg-surface">
                <span class="text-lg" aria-hidden="true">
                  {r.icon}
                </span>
                {r.text}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CTA / Download -->
    <section id="download" class="py-20 md:py-28" aria-labelledby="cta-heading">
      <div
        class="relative mx-auto max-w-4xl overflow-hidden rounded-3xl border border-accent/20 bg-gradient-to-br from-accent/10 to-surface px-6 py-16 text-center md:px-16"
      >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div
            class="absolute -top-20 -left-20 h-60 w-60 rounded-full bg-accent/10 blur-[80px]"
          >
          </div>
        </div>

        <div class="relative">
          <img
            src="/mascot.png"
            alt=""
            aria-hidden="true"
            class="mx-auto mb-6 w-28 drop-shadow-xl"
            width="260"
            height="260"
            loading="lazy"
          />
          <h2
            id="cta-heading"
            class="mb-3 text-3xl font-extrabold tracking-tight md:text-4xl"
          >
            Ready to become a VTuber?
          </h2>
          <p class="mx-auto mb-8 max-w-md text-text-muted">
            Download Chibi-FX for free and bring your avatar to life today.
          </p>
          <a
            href="#"
            id="cta-download-btn"
            class="inline-flex items-center gap-2 rounded-full bg-accent px-8 py-3.5 text-base font-bold text-bg transition-transform hover:scale-105"
            aria-label="Download Chibi-FX latest release"
          >
            Download Latest Release
            <svg
              class="h-5 w-5"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
              ></path><polyline points="7 10 12 15 17 10"></polyline><line
                x1="12"
                y1="15"
                x2="12"
                y2="3"></line></svg
            >
          </a>
          <p class="mt-4 text-xs text-text-dim">
            Free forever · Desktop · Powered by Godot
          </p>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-border bg-surface py-8" role="contentinfo">
    <div
      class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6"
    >
      <div class="flex items-center gap-2 font-extrabold">
        <span class="text-lg" aria-hidden="true">🐱</span>
        <span>Chibi<span class="text-accent">FX</span></span>
      </div>
      <p class="text-sm text-text-muted">
        Made with ❤️ and Godot · © 2026 Chibi-FX
      </p>
    </div>
  </footer>

  <!-- Minimal JS: nav shadow + scroll reveals -->
  <script>
    const nav = document.getElementById("main-nav");
    if (nav) {
      window.addEventListener(
        "scroll",
        () => nav.classList.toggle("border-border", window.scrollY > 10),
        { passive: true },
      );
    }
  </script>

  <!-- Float animation keyframes -->
  <style>
    @keyframes float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-12px);
      }
    }
  </style>
</Layout>
